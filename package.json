{
  "name": "zcode-skins",
  "version": "1.0.0",
  "description": "Skin Center and Custom Wallpaper/Backdrop Plugin for ZCode Desktop, adapted from hermes-skins",
  "main": "plugin.js",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js && node scripts/build-scene-helper.js && node scripts/build-native-package.js",
    "test": "node --test tests/*.test.js",
    "pretest": "npm run build",
    "install:zcode": "node scripts/install-permanent.mjs --restart",
    "restore:official": "node scripts/restore-official.mjs --restart",
    "patch:asar": "node scripts/patch-asar.mjs"
  },
  "keywords": [
    "zcode",
    "zcode-desktop",
    "zcode-agent",
    "skins",
    "themes",
    "wallpaper",
    "skin-center",
    "ui-plugin"
  ],
  "author": "CaptainMusX",
  "license": "SEE LICENSE IN LICENSING.md",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CaptainMusX/zcode-skins.git"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jpeg-js": "^0.4.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
